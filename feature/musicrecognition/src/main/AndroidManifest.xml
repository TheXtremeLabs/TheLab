<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:node="merge">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.microphone"
        tools:node="merge" />

    <queries tools:node="merge">
        <!-- Allows to check if spotify package exists starting from Android API 30 -->
        <package android:name="com.spotify.music" />
    </queries>

    <application tools:node="merge">
        <activity
            android:name=".ui.MusicRecognitionChooserActivity"
            android:exported="true" />
        <activity
            android:name=".ui.acrcloud.ACRCloudActivity"
            android:parentActivityName=".ui.MusicRecognitionChooserActivity" />
    </application>
</manifest>